# ===== Carousel engine — optional environment =====
# Only needed for the PAID kie.ai path (the Higgsfield connector and the free path need nothing here).
# 1. Copy this file to  .env  in the user's workspace folder (CAROUSEL_WORKSPACE) or the current folder.
# 2. Paste a kie.ai API key below (get one at https://kie.ai/api-key). .env is private — never share it.

KIE_API_KEY=your_kie_ai_key_here

# --- Optional overrides (defaults are fine) ---
# CAROUSEL_WORKSPACE=~/Documents/carousels   # where profile, my-images, runs and output go
# CAROUSEL_MODEL=nano-banana-pro      # kie model for backgrounds (nano-banana-pro | nano-banana-2 | gpt-image-2-image-to-image)
# CAROUSEL_BG_ASPECT=4:5              # 1:1 2:3 3:4 4:5 9:16 16:9 ...
# CAROUSEL_BG_RESOLUTION=2K           # 1K | 2K | 4K
# CAROUSEL_WORKERS=3                  # parallel background generations
# UPLOAD_PROVIDER=catbox              # how the style reference is hosted for kie (catbox | 0x0)
